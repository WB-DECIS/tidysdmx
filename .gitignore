# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/

# Environments
.venv/
venv/
env/
ENV/
.python-version

# uv
# NOTE: uv.lock is deliberately NOT ignored. It is the reproducible build record,
# and `uv sync --locked` in CI requires it to be committed.
# Written by `make audit` (locally and in security.yml) as pip-audit's input.
requirements-audit.txt

# Testing / coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

# Type checkers and linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Documentation build output (great-docs + Quarto)
great-docs/
.quarto/
_site/
# Quarto's computation cache, created at the project root by `make docs`.
_freeze/
llms.txt
llms-full.txt

# Editors / IDEs
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Claude Code — personal overrides stay local, shared settings are committed
.claude/settings.local.json

# Secrets — belt and braces; never commit credentials
.env
.env.*
!.env.example
*.pem
*.key
*.token
*.creds
*.secret

# tidysdmx-specific
notebooks/TMP/
TMP/
notebooks/tidysdmx/config.json
.ipynb_checkpoints
profile_default/
ipython_config.py
# Input for AI agents
docs/.local-docs
.pysdmx-src/
# RStudio / PyCharm project files
**.Rproj.user/
**.Rproj.user*
**.Rproj
**.Rhistory
.idea/
