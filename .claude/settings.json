{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(uv run python:*)",
      "Bash(uv run --no-sync python:*)",
      "Bash(uv run --group:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(uv build)",
      "Bash(uv tree:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh release:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(uv run --group release:*)",
      "Bash(git reset --hard:*)",
      "Bash(uv publish:*)",
      "Bash(twine upload:*)",
      "Bash(rm -rf:*)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}
